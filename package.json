{
  "name": "motoneta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "audio:engines": "node scripts/build-audio.mjs --engines-only",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:compat": "playwright test --config=playwright.compat.config.ts",
    "benchmark:runtime": "node scripts/benchmark-runtime.mjs",
    "models:validate": "node scripts/validate-motocross.mjs",
    "models:review:motoneta": "node scripts/review-motoneta.mjs",
    "models:benchmark:motoneta": "node scripts/benchmark-motoneta.mjs",
    "models:review:tanque": "node scripts/review-tanque.mjs",
    "models:benchmark:tanque": "node scripts/benchmark-tanque.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.19.0",
    "@types/three": "0.180.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vitest": "^3.2.4"
  }
}
