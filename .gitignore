# Runtime files are tracked by default; development sources may be added explicitly.
/*
!/.gitignore
!/README.md
!/index.html
!/loop-prototype.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/tsconfig.tests.json
!/playwright.compat.config.ts
!/vite.config.ts
!/src/
!/public/
!/scripts/
!/tests/
!/.github/
!/.agents/
!/assets/

# Keep only the model authoring source and concepts from local asset work.
/assets/*
!/assets/motocross/
!/assets/motoneta/
!/assets/tanque/
!/assets/track-pieces/
/scripts/*
!/scripts/validate-motocross.mjs
!/scripts/build-motocross.py
!/scripts/build-loop-prototype.py
!/scripts/review-loop-prototype.mjs
!/scripts/review-loop-integration.mjs
!/scripts/review-motoneta.mjs
!/scripts/benchmark-motoneta.mjs
!/scripts/review-tanque.mjs
!/scripts/benchmark-tanque.mjs
!/scripts/check-motoneta-model.py
!/scripts/review-model-quality.mjs
!/scripts/check-motocross-topology.py
!/scripts/compare-model-performance.mjs
!/scripts/check-rider-clearance.py
!/scripts/benchmark-runtime.mjs
# Large runtime snapshots are reproducible from the review script; retain the diagnostic report.
/assets/motocross/review/**/posed-geometry.json
/assets/motocross/review/**/posed-geometry.json.gz
/assets/motocross/review/**/.last-run.json
/assets/motoneta/review/*/baseline/
/assets/track-pieces/loop-prototype/review/**/*.png
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/motoneta-3d/
!/.agents/skills/motoneta-3d/SKILL.md

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml

# Other local documentation and working files stay outside the repository.
docs/
*.md
!/.agents/skills/motoneta-3d/SKILL.md
*.mdx
*.rst
*.pdf
!/README.md
*.log
*.blend1
*.local
.env
.env.*
.DS_Store
node_modules/
/.blender-mcp-venv/
dist/
tmp/
test-results/
playwright-report/
