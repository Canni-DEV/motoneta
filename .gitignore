# Runtime files are tracked by default; development sources may be added explicitly.
/*
!/.gitignore
!/README.md
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/src/
!/public/
!/scripts/
!/tests/
!/.github/
!/.agents/
!/assets/

# Keep only the model authoring source and concepts from local asset work.
/assets/*
!/assets/motocross/
/scripts/*
!/scripts/validate-motocross.mjs
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/motoneta-3d/
!/.agents/skills/motoneta-3d/SKILL.md

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml

# Other local documentation and working files stay outside the repository.
docs/
*.md
!/.agents/skills/motoneta-3d/SKILL.md
*.mdx
*.rst
*.pdf
!/README.md
*.log
*.local
.env
.env.*
.DS_Store
node_modules/
/.blender-mcp-venv/
dist/
tmp/
test-results/
playwright-report/
