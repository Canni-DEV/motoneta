# Runtime files are tracked by default; development sources may be added explicitly.
/*
!/.gitignore
!/README.md
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/src/
!/public/
!/.github/

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml

# Other local documentation and working files stay outside the repository.
docs/
*.md
*.mdx
*.rst
*.pdf
!/README.md
*.log
*.local
.env
.env.*
.DS_Store
node_modules/
dist/
tmp/
test-results/
playwright-report/
